# Copy to .env.local_research (gitignored). Research-only; no live broker secrets.

# Root for datasets, artifacts, exports (WSL path recommended)
FXG_RESEARCH_ROOT=${HOME}/fxg-research

# Repo checkout (this project). Defaults derived from script location if unset.
# FXG_REPO_ROOT=/path/to/Gcloud system

# Optional: paper/history APIs for enrichment (fail verify if required and missing)
# OANDA_API_KEY=
# OANDA_ACCOUNT_ID=

# Monte Carlo
MC_WORKERS=24
MC_ITERATIONS=500
MC_SEED=42

# Research API (optional local read-only server)
RESEARCH_API_ENABLED=0
RESEARCH_API_HOST=127.0.0.1
RESEARCH_API_PORT=8790

# ALPHA import helper (scp). Dry-run unless ALPHA_IMPORT_APPLY=1
# ALPHA_SSH_TARGET=user@alpha-host
# ALPHA_RESEARCH_IMPORT_DIR=/home/user/fxg-research-import/incoming
