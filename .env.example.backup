# AI_QUANT Control Plane Environment Variables
# 
# COPY this file to .env and fill in your actual values.
# NEVER commit .env to git!
#
# Usage:
#   cp .env.example .env
#   # Edit .env with your actual values
#   # .env is gitignored and will not be committed

# === OANDA CREDENTIALS (REQUIRED for trading) ===
# Get from: https://www.oanda.com/demo-account/ (practice) or live account
OANDA_API_KEY=your-oanda-api-key-here
OANDA_ACCOUNT_ID=your-oanda-account-id-here
OANDA_ENV=practice
# OANDA_BASE_URL is optional; defaults based on OANDA_ENV
# OANDA_BASE_URL=https://api-fxpractice.oanda.com

# === TELEGRAM ALERTS (OPTIONAL) ===
# Create bot: https://t.me/BotFather
# Get chat ID: https://api.telegram.org/bot<token>/getUpdates
TELEGRAM_BOT_TOKEN=your-telegram-bot-token-here
TELEGRAM_CHAT_ID=your-telegram-chat-id-here

# === CONTROL PLANE AUTH (OPTIONAL - auto-generated if not set) ===
# Generate: python3 -c "import secrets; print(secrets.token_hex(32))"
# CONTROL_PLANE_TOKEN=your-control-plane-token-here

# === NEWS PROVIDERS (OPTIONAL - at least one recommended) ===
# NewsAPI: https://newsapi.org/register
NEWSAPI_API_KEY=your-newsapi-key-here

# MarketAux: https://www.marketaux.com/
# Supports CSV for multiple keys: MARKETAUX_KEYS=key1,key2,key3
MARKETAUX_KEYS=your-marketaux-key-here
# Or legacy single key:
# MARKETAUX_KEY=your-marketaux-key-here

# AlphaVantage: https://www.alphavantage.co/support/#api-key
# Supports CSV for multiple keys: ALPHAVANTAGE_API_KEYS=key1,key2,key3
ALPHAVANTAGE_API_KEYS=your-alphavantage-key-here
# Or legacy single key:
# ALPHAVANTAGE_API_KEY=your-alphavantage-key-here

# Polygon.io: https://polygon.io/
# Supports CSV for multiple keys: POLYGON_API_KEYS=key1,key2,key3
POLYGON_API_KEYS=your-polygon-key-here
# Or legacy single key:
# POLYGON_API_KEY=your-polygon-key-here

# Financial Modeling Prep: https://site.financialmodelingprep.com/developer/docs/
# Supports CSV for multiple keys: FMP_API_KEYS=key1,key2,key3
FMP_API_KEYS=your-fmp-key-here
# Or legacy single key:
# FMP_API_KEY=your-fmp-key-here

# Finnhub: https://finnhub.io/
# Supports CSV for multiple keys: FINNHUB_API_KEYS=key1,key2,key3
FINNHUB_API_KEYS=your-finnhub-key-here
# Or legacy single key:
# FINNHUB_API_KEY=your-finnhub-key-here

# === MACRO DATA (FRED) (OPTIONAL) ===
# FRED API: https://fred.stlouisfed.org/docs/api/api_key.html
# Supports CSV for multiple keys: FRED_API_KEYS=key1,key2,key3
FRED_API_KEYS=your-fred-api-key-here
# Or legacy single key:
# FRED_API_KEY=your-fred-api-key-here

# FRED Series IDs to fetch (CSV)
# Common series: UNRATE (unemployment), GDP, CPIAUCSL (CPI), etc.
# FRED_SERIES_IDS=UNRATE,GDP,CPIAUCSL

# === AI INSIGHTS (OPTIONAL) ===
# OpenAI: https://platform.openai.com/api-keys
OPENAI_API_KEY=your-openai-api-key-here
OPENAI_MODEL=gpt-4o-mini
AI_INSIGHTS_ENABLED=0
AI_INSIGHTS_MODE=advisory

# Google AI / Gemini: https://makersuite.google.com/app/apikey
GOOGLE_API_KEY=your-google-api-key-here
# Or use GEMINI_API_KEY alias:
# GEMINI_API_KEY=your-gemini-api-key-here
GEMINI_MODEL=gemini-1.5-flash
AI_PROVIDER=openai
# AI_PROVIDER_CHAIN=openai,gemini

# === TRADING MODE (SAFE DEFAULTS - DO NOT CHANGE) ===
# These ensure paper-safe mode by default
TRADING_MODE=paper
EXECUTION_ENABLED=false

# === CONTROL PLANE CONFIG (OPTIONAL) ===
# CP_HOST=127.0.0.1
# CP_PORT=8787
# CONTROL_PLANE_TOKEN_FILE=/tmp/control_plane_token_current.txt
