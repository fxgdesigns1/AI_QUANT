# Environment Variables Template
# Copy this to .env and fill in real values
# .env is gitignored - NEVER commit it

# OANDA Trading (REQUIRED)
OANDA_API_KEY=
OANDA_ACCOUNT_ID=
OANDA_ENV=practice

# Telegram Notifications (OPTIONAL)
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# Telegram Notification Policy (defaults shown)
# Control which message classes are sent to Telegram
TELEGRAM_ENABLE_SCHEDULED_RUN_SUMMARY=true
TELEGRAM_ENABLE_DIAGNOSTIC_HEARTBEAT=true
TELEGRAM_ENABLE_CRITICAL_ALERTS=true
TELEGRAM_SUPPRESS_SIGNAL_CHATTER=true

# News/Data APIs (OPTIONAL)
NEWSAPI_API_KEY=
ALPHAVANTAGE_API_KEY=

# MarketAux Keys (OPTIONAL - comma-separated for rotation)
# Example: MARKETAUX_KEYS=key1,key2,key3
MARKETAUX_KEYS=

# OpenAI (AI insights)
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini


# AI (Optional)
AI_INSIGHTS_ENABLED=0
AI_INSIGHTS_MODE=advisory
AI_PROVIDER=openai
# To enable fallback: AI_PROVIDER_CHAIN=openai,gemini
AI_PROVIDER_CHAIN=
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini
GOOGLE_API_KEY=
GEMINI_MODEL=gemini-1.5-flash

# Windows MT5 Sidecar Configuration (OPTIONAL)
# Enable sidecar connectivity for enhanced telemetry and account probing
MT5_SIDECAR_ENABLED=false
MT5_SIDECAR_BASE_URL=http://100.123.26.120:8877
MT5_SIDECAR_API_KEY=your_sidecar_api_key_here

# --- Dashboard (Next.js: dashboard/) — see docs/DASHBOARD_ENV_CONTRACT.md ---
# Copy dashboard/.env.example → dashboard/.env.local for Mac dev.
# Owner VM: deploy/dashboard.env.owner-vm.example → /etc/ai-quant/dashboard.env
