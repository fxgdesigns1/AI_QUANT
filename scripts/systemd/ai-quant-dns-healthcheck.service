[Unit]
Description=AI_QUANT DNS Healthcheck
After=network.target

[Service]
Type=oneshot
# Check DNS resolution and basic HTTP connectivity
# If fail: Log error and restart systemd-resolved (self-heal)
ExecStart=/bin/bash -c 'if ! getent hosts api-fxpractice.oanda.com >/dev/null || ! curl -I -m 5 https://api-fxpractice.oanda.com/v3/accounts >/dev/null 2>&1; then echo "DNS_HEALTHCHECK_FAIL: Restarting systemd-resolved"; systemctl restart systemd-resolved; exit 1; fi; echo "DNS_HEALTHCHECK_PASS"'
User=root
Group=root
