[Unit]
Description=AI_QUANT Control Plane (API Server, Dashboard)
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=aiquant
WorkingDirectory=/opt/ai-quant
Environment=PYTHONUNBUFFERED=1
# Load env from file (0600 permissions)
EnvironmentFile=/etc/ai-quant/.env
# Start control plane in foreground (systemd manages process)
ExecStart=/bin/bash -c 'cd /opt/ai-quant && source .venv/bin/activate && CONTROL_PLANE_BG=0 bash scripts/start_control_plane_clean.sh'
Restart=always
RestartSec=3

# Hardening
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=full
ProtectHome=true
ReadWritePaths=/tmp /opt/ai-quant/runtime /opt/ai-quant/logs

# Logging
StandardOutput=journal
StandardError=journal
SyslogIdentifier=ai-quant-control-plane

[Install]
WantedBy=multi-user.target
