# LAB dashboard (isolated) - localhost only
# NOTE: SSL + basic auth are intentionally omitted because the VM currently has:
# - no /etc/nginx/ssl cert/key paths
# - no /etc/nginx/.htpasswd
# Access model remains safe via SSH tunnel to localhost:9443.
server {
  listen 127.0.0.1:9443;
  server_name localhost;
  root /var/www/dashboards/lab/current;

  # Prevent stale HTML issues while allowing asset caching
  location = /index.html {
    add_header Cache-Control "no-store" always;
  }

  location / {
    index index.html;
    try_files $uri $uri/ /index.html;
  }

  location /api/ {
    proxy_pass http://127.0.0.1:8787;
    proxy_http_version 1.1;
    proxy_set_header Host $host;
    proxy_set_header X-Real-IP $remote_addr;
    proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
    proxy_set_header X-Forwarded-Proto http;
    proxy_read_timeout 300;
  }
}

