  "COMMANDS_TO_RUN_ON_5950X": {
    "step_1_setup": [
      "bash ~/fxg-ai-quant-local/repo/scripts/setup_local_research_env.sh",
      "python3 -m venv ~/fxg-ai-quant-local/venv",
      "source ~/fxg-ai-quant-local/venv/bin/activate",
      "pip install -r ~/fxg-ai-quant-local/repo/requirements.txt"
    ],
    "step_2_configure": [
      "cp ~/fxg-ai-quant-local/repo/.env.research.example ~/fxg-ai-quant-local/.env.research",
      "export $(cat ~/fxg-ai-quant-local/.env.research | grep -v '^#' | xargs)"
    ],
    "step_3_sync_artifacts": [
      "export VM_PROJECT='fxg-ai-trading'",
      "export VM_ZONE='us-east1-b'",
      "export VM_INSTANCE='fxg-quant-paper-e2-micro'",
      "bash ~/fxg-ai-quant-local/repo/scripts/sync_vm_artifacts.sh"
    ],
    "step_4_smoke_test": [
      "bash ~/fxg-ai-quant-local/repo/scripts/smoke_test_cached_backtest.sh"
    ],
    "step_5_monte_carlo": [
      "source ~/fxg-ai-quant-local/venv/bin/activate",
      "python3 ~/fxg-ai-quant-local/repo/scripts/run_monte_carlo.py --input-tournament ~/fxg-ai-quant-local/artifacts/backtests/tournament_dataset_20260307T222011Z_recent30_enriched_wave2_v1/report.json --output ~/fxg-ai-quant-local/artifacts/monte_carlo/mc_$(date +%Y%m%dT%H%M%SZ) --iterations 1000 --workers 16 --seed 42 --mode reshuffle"
    ]
  },
  
  "COMMANDS_TO_RUN_ON_M1": {
    "setup": [
      "mkdir -p ~/fxg-ai-quant-local",
      "ln -sfn <existing-repo-path> ~/fxg-ai-quant-local/repo"
    ],
    "inspection": [
      "ls -lh ~/fxg-ai-quant-local/artifacts/monte_carlo/*/monte_carlo_summary.json",
      "cat ~/fxg-ai-quant-local/artifacts/backtests/*/tournament_results.json | jq"
    ]
  },
  
  "VERIFICATION_COMMANDS": {
    "check_local_layout": "ls -la ~/fxg-ai-quant-local/",
    "check_venv": "test -d ~/fxg-ai-quant-local/venv && echo 'venv exists'",
    "check_cached_candles": "test -d ~/fxg-ai-quant-local/artifacts/candles/tournament_dataset_20260307T222011Z_recent30_enriched && echo 'candles synced'",
    "check_no_oanda_required": "unset OANDA_API_KEY && bash ~/fxg-ai-quant-local/repo/scripts/smoke_test_cached_backtest.sh",
    "check_monte_carlo_output": "test -f ~/fxg-ai-quant-local/artifacts/monte_carlo/*/monte_carlo_summary.json && echo 'MC complete'"
  },
  
